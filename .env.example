# Copy to .env and adjust.  .env is gitignored; never commit real credentials.

# ---------------------------------------------------------------------------
# MinIO (local S3-compatible storage)
# ---------------------------------------------------------------------------
# Required -- docker compose refuses to start without it.
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# Backend object storage
# ---------------------------------------------------------------------------
# s3   -> persists to the bucket below (MinIO locally, AWS S3 in a deployment)
# mock -> in-process dict; nothing is persisted.  Tests only.
STEP1_STORAGE_MODE=s3

S3_BUCKET=medflow-documents
S3_REGION=us-east-1
# Point at MinIO locally.  Leave EMPTY for real AWS S3.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO needs path-style addressing; AWS S3 accepts either.
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=step1

# Server-side encryption: none | AES256 | aws:kms
S3_SSE=none
S3_SSE_KMS_KEY_ID=

# How long a presigned download URL stays valid (clamped to 60..3600).
S3_PRESIGN_EXPIRY_SECONDS=300
S3_TIMEOUT_SECONDS=10
S3_MAX_RETRIES=2
# Leave false. minio-init creates the bucket, and a real deployment should not
# grant the application CreateBucket.
S3_CREATE_BUCKET_IF_MISSING=false
S3_SEND_CHECKSUM=true

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_UPLOAD_MIME_TYPES=text/plain,application/pdf,image/png,image/jpeg,image/webp,image/tiff
# Verify leading bytes match the declared type.  Disable only to debug.
UPLOAD_MAGIC_BYTE_CHECK=true

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
